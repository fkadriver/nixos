# Ignore build outputs from performing a nix-build or `nix build` command
result
result-*

# Ignore any vm builds
*.qcow2
*.qcow2.tmp

# SD card image backups
*.img

# Ignore automatically generated direnv output
.direnv

# Secrets - DO NOT commit unencrypted secrets!
secrets/*.tmp
secrets/*.dec
secrets/*.backup

# Editor files
*.swp
*.swo
*~
.*.sw?
.vscode/
.idea/
.claude/settings.local.json

# OS files
.DS_Store
Thumbs.db

# Temp photos
*.JPEG
.sops.yaml
archive/pkgs/idrive-e360/IDrive360.deb
airbook-errors.txt
