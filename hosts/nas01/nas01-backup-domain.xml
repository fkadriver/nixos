<domain type='kvm'>
  <name>nas01-backup</name>
  <uuid>843679ec-786b-42fc-87eb-868a66bb4dc4</uuid>
  <memory unit='MiB'>4096</memory>
  <currentMemory unit='MiB'>4096</currentMemory>
  <vcpu placement='static'>3</vcpu>
  <!-- nas01 is a Xeon E3-1270 v5, 4C/8T (lscpu -e: core0=cpus 0,4; core1=1,5;
       core2=2,6; core3=3,7). Pin the VM's 3 vcpus to cores 1-3, leaving core0
       (cpus 0,4) untouched by qemu so nas01's own ZFS/Samba/Borg work always
       has a full physical core free. shares=512 (half of the host default
       1024) means the VM only wins scheduling on cores 1-3 when nas01 isn't
       contending for them — it can burst up to all 3 cores when idle, but
       backs off under host load rather than starving it. -->
  <cputune>
    <vcpupin vcpu='0' cpuset='1,5'/>
    <vcpupin vcpu='1' cpuset='2,6'/>
    <vcpupin vcpu='2' cpuset='3,7'/>
    <emulatorpin cpuset='1,2,3,5,6,7'/>
    <shares>512</shares>
  </cputune>
  <cpu mode='host-passthrough' check='none'/>
  <os>
    <type arch='x86_64' machine='q35'>hvm</type>
    <boot dev='hd'/>
  </os>
  <features>
    <acpi/>
    <apic/>
  </features>
  <clock offset='utc'>
    <timer name='rtc' tickpolicy='catchup'/>
    <timer name='pit' tickpolicy='delay'/>
    <timer name='hpet' present='no'/>
  </clock>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>restart</on_crash>
  <!-- Required for virtiofs shared-memory transport -->
  <memoryBacking>
    <source type='memfd'/>
    <access mode='shared'/>
  </memoryBacking>
  <devices>
    <!-- Main disk: qcow2 backed by Ubuntu 24.04 cloud image -->
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2'/>
      <source file='/var/lib/libvirt/images/nas01-backup.qcow2'/>
      <target dev='vda' bus='virtio'/>
    </disk>
    <!-- Cloud-init seed ISO (detached after first boot if desired) -->
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='/var/lib/libvirt/images/nas01-backup-cidata.iso'/>
      <target dev='sda' bus='sata'/>
      <readonly/>
    </disk>
    <interface type='network'>
      <source network='default'/>
      <model type='virtio'/>
      <!-- Pinned: cloud-init baked this MAC into the guest's netplan match
           rule (/etc/netplan/50-cloud-init.yaml) at first boot. Without a
           pin here, libvirt assigns a random MAC on every `virsh define`,
           which stops matching netplan's rule and leaves the interface
           down with no DHCP lease — happened on the 2026-08-20 T330 restore. -->
      <mac address='52:54:00:b8:1a:d8'/>
    </interface>
    <!-- Guest agent: enables virsh domifaddr, graceful shutdown, etc. -->
    <channel type='unix'>
      <target type='virtio' name='org.qemu.guest_agent.0'/>
    </channel>
    <!-- Serial console for virsh console -->
    <serial type='pty'>
      <target type='isa-serial' port='0'>
        <model name='isa-serial'/>
      </target>
    </serial>
    <console type='pty'>
      <target type='serial' port='0'/>
    </console>
    <!-- VNC bound to nas01's tailscale IP only. No VNC password: tailscale0 is a
         trustedInterfaces entry (modules/tailscale.nix), so reachability is already
         gated by tailnet membership — matches the in-guest x11vnc's security model,
         which relies on a password since it listens on the guest's tailscale IP
         directly rather than the host's. -->
    <graphics type='vnc' port='-1' autoport='yes' listen='100.73.114.76'>
      <listen type='address' address='100.73.114.76'/>
    </graphics>
    <video>
      <!-- 1440x900 matches the airbook's native panel (MacBook Air 7,2, 13"
           non-Retina) 1:1 — the primary console viewer. Confirmed available
           in the guest's virtio-gpu EDID mode list via xrandr's query mode. -->
      <model type='virtio' heads='1' primary='yes'>
        <resolution x='1440' y='900'/>
      </model>
    </video>
    <!-- virtiofs shares: /pool (IDrive360 backup source), /mnt (extra drives),
         and /home/scott/git (repo access from the guest). All read-write —
         accessmode='passthrough' with no <readonly/> tag. -->
    <filesystem type='mount' accessmode='passthrough'>
      <driver type='virtiofs'/>
      <source dir='/pool'/>
      <target dir='pool'/>
    </filesystem>
    <filesystem type='mount' accessmode='passthrough'>
      <driver type='virtiofs'/>
      <source dir='/mnt'/>
      <target dir='mnt'/>
    </filesystem>
    <filesystem type='mount' accessmode='passthrough'>
      <driver type='virtiofs'/>
      <source dir='/home/scott/git'/>
      <target dir='git'/>
    </filesystem>
    <memballoon model='virtio'/>
    <rng model='virtio'>
      <backend model='random'>/dev/urandom</backend>
    </rng>
  </devices>
</domain>
